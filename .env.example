# Copy to .env (git-ignored). Read by the backend only; never by the frontend.

# Optional: ElevenLabs credentials for a private (auth-enabled) agent.
# Leave blank to run without voice, or to use a public agent via frontend/.env.local.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Shared secret ElevenLabs webhook tools must send as X-Agent-Tools-Secret.
# Set this before exposing the backend through a tunnel.
AGENT_TOOLS_SECRET=

# Optional overrides
# ACEASSIST_DB_PATH=backend/aceassist.db
# FRONTEND_ORIGIN=http://localhost:5173
